{
	"name": "prompt-injection-checker",
	"private": true,
	"packageManager": "pnpm@10.18.1",
	"scripts": {
		"dev": "pnpm --filter webapp dev",
		"build": "pnpm --filter webapp build",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "pnpm --filter webapp typecheck",
		"verify": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm depcruise",
		"test:unit": "pnpm --filter webapp test:unit",
		"test:coverage": "pnpm --filter webapp test:coverage",
		"depcruise": "pnpm --filter webapp depcruise",
		"knip": "knip",
		"prepare": "simple-git-hooks"
	},
	"simple-git-hooks": {
		"pre-commit": "pnpm lint:fix",
		"pre-push": "pnpm verify"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9",
		"knip": "^6.25.0",
		"simple-git-hooks": "^2.13.1"
	},
	"pnpm": {
		"onlyBuiltDependencies": ["@biomejs/biome", "esbuild", "sharp", "simple-git-hooks"]
	}
}
